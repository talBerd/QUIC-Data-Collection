import time, os, re
from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.common.keys import Keys
from selenium.webdriver.chrome.service import Service
from webdriver_manager.chrome import ChromeDriverManager


# Set up Selenium WebDriver
options = webdriver.ChromeOptions()
options.add_argument("--headless")  # Run without opening a browser
options.add_argument("--disable-gpu")
options.add_argument("--window-size=1920,1080")
options.add_argument("--disable-blink-features=AutomationControlled")

# Initialize WebDriver
driver = webdriver.Chrome(service=Service(ChromeDriverManager().install()), options=options)

max_scrolls=0
max_results=0
page_url=""
output_dir = ""

while True:
    platform = input("Enter platform to scrap: ").lower()
    if platform == "youtube":
        page_url="https://www.youtube.com/live"
        output_dir = "links/youtube.com/"
        break
    elif platform == "dailymotion":
        page_url="https://www.dailymotion.com/"
        output_dir = "links/dailymotion.com/"
        break
    elif platform == "twitch":
        page_url="https://www.twitch.tv/videos/"
        output_dir = "links/twitch.tv/"
        break
    elif platform == "rumble":
        page_url="https://rumble.com/"
        output_dir = "links/rumble.com/"
        break
    elif platform == "vimeo":
        page_url="https://vimeo.com/watch"
        output_dir = "links/vimeo.com/"
        break
    print("Unsupported platform")


# Open relevant page
driver.get(page_url)
time.sleep(5)  # Wait for the page to load

# Output file
os.makedirs(output_dir, exist_ok=True)
output_file = os.path.join(output_dir, "links.txt")

while max_results <=0:
    max_results = int(input("Enter the maximum number of related videos to fetch: "))

while max_scrolls <=0:
    max_scrolls = int(input("Enter the maximum number of related scrolls to fetch: "))



# Function to scroll and extract links
def get_rumble_video_links(max_links=10,scrolls=50, wait_time=3):

    if os.path.exists(output_file):
        links = set(open(output_file).read().splitlines())
    else:
        links = set()

    for _ in range(scrolls):
        # Scroll to bottom
        driver.find_element(By.TAG_NAME, "body").send_keys(Keys.END)
        time.sleep(wait_time)  # Increased wait time to let YouTube load more videos

        # Extract live stream links
        elements = driver.find_elements(By.TAG_NAME, 'a')  # Get all links
        for elem in elements:
            link = elem.get_attribute("href")
            if link and re.search(r'https://rumble.com/v\d+', link):
                link = link.split('.html')[0]+".html"
                if link not in links:
                    print(f"Found live stream: {link}")
                    links.add(link)

            # Stop scrolling if no new videos are loading
            if len(links) >= max_links:  # Adjust this threshold based on what you observe
                print("Reached threshold")
                return list(links)

    return list(links)

def get_twitch_video_links(max_links=10, scrolls=50, wait_time=3):
    if os.path.exists(output_file):
        links = set(open(output_file).read().splitlines())
    else:
        links = set()

    for _ in range(scrolls):
        # Scroll to bottom
        driver.find_element(By.TAG_NAME, "body").send_keys(Keys.END)
        time.sleep(wait_time)  # Increased wait time to let Twitch load more content

        # Extract video links
        elements = driver.find_elements(By.XPATH,'//*')  # Get all links
        for elem in elements:
            link = elem.get_attribute("href")
            if link and re.match(r'^https://www.twitch.tv/([^/?.]+)$', link):  # Match Twitch VODs
                if link not in links and "directory" not in link and "videos" not in link:
                    print(f"Found Twitch VOD: {link}")
                    links.add(link)

            # Stop scrolling if we reach the max number of links
            if len(links) >= max_links:
                print("Reached threshold")
                return list(links)

    return list(links)


